{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DualDNS Browser permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/dual-dns-proxy",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/dual-dns-proxy",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
